generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  CUSTOMER
  VENDOR
  ADMIN
}

enum NotificationTargetType {
  USER
  USERS
  ROLE
  ALL_USERS
}

// ── Address Book ──────────────────────────────────────────────────────────────
model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   // e.g. "Home", "Office"
  fullName   String
  phone      String
  street     String
  city       String
  state      String
  country    String   @default("Bangladesh")
  zipCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}



// ── Order Tracking Timeline ───────────────────────────────────────────────────
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?     // e.g. "Picked up by courier"
  createdAt DateTime    @default(now())
}

// ── Product Tags ──────────────────────────────────────────────────────────────
model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([productId, tagId])
}

// ── Product Q&A ───────────────────────────────────────────────────────────────
model ProductQuestion {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   User            @relation("CustomerQuestions", fields: [customerId], references: [id])
  question   String
  answer     String?
  answeredAt DateTime?
  answeredBy String?         // vendor userId
  createdAt  DateTime        @default(now())
  @@index([productId])
  @@index([customerId])
}

// ── Stock Alerts ──────────────────────────────────────────────────────────────
model StockAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@unique([userId, productId])
    @@index([productId, notified])
}

// ── Push Notification Subscriptions ──────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String
  role                Role      @default(CUSTOMER)
  store               Store?
  isEmailVerified     Boolean   @default(false)
  emailVerifyToken    String?
  emailVerifyExpiry   DateTime?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  emailNotificationEnabled Boolean @default(true)
  phone     String?

  orders              Order[]
  notifications  Notification[]
  returnRequests ReturnRequest[]
  addresses          Address[]
pushSubscriptions  PushSubscription[]
stockAlerts        StockAlert[]
questions          ProductQuestion[] @relation("CustomerQuestions")
  reviews Review[]
  cart Cart?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
    @@index([email])
@@index([role])
}

model Store {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logo        String?
  ownerId     String    @unique
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products    Product[]
  orderItems OrderItem[]
  isActive    Boolean   @default(true)

  // stats
  totalSales    Int      @default(0)
  totalRevenue  Decimal  @default(0)
  rating        Float    @default(0)

  isFeatured    Boolean  @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([ownerId])
  @@index([isActive])
  @@index([slug])
  @@index([totalSales])
  @@index([rating])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  isFeatured Boolean? @default(false)
  image     String?
  products  Product[]

  createdAt DateTime  @default(now())
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  price       Decimal
  originalPrice Decimal?
  stock       Int              @default(0)
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  isActive    Boolean          @default(true)
  featured Boolean @default(false)
bestseller Boolean @default(false)
rating        Float @default(0)
  reviewCount   Int            @default(0)
   brandId       String?
   orderCount Int @default(0)
  brand     Brand?  @relation(fields: [brandId], references: [id])
  orderItems OrderItem[]
  cartItems CartItem[]
  reviews Review[]
  tags       ProductTag[]
questions  ProductQuestion[]
stockAlerts StockAlert[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

    @@index([storeId])
  @@index([categoryId])
  @@index([isActive])
  @@index([price])
  @@index([createdAt])
  @@index([storeId, isActive])       // compound — vendor product listing
  @@index([categoryId, isActive])    // compound — category browsing
}

model Brand{
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  slug String @unique

}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  productId String
  publicId  String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        String  @id @default(cuid())
  name      String  // e.g. "Color", "Size"
  value     String  // e.g. "Red", "XL"
  price     Decimal? // optional override price
  stock     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
   cartItems CartItem[]
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentGateway {
  SSLCOMMERZ
  STRIPE
  BKASH
  MANUAL
}

model Payment {
  id              String          @id @default(cuid())
  orderId         String          @unique
  order           Order           @relation(fields: [orderId], references: [id])
  status          PaymentStatus   @default(PENDING)
  cardName    String?
 last4       String?   // only last 4 digits
   provider    String?   // stripe, sslcommerz, cod
   gateway   PaymentGateway
  amount          Decimal
  currency        String          @default("BDT")
  transactionId   String?         // gateway transaction ID
  sessionId       String?         // stripe session ID / sslcommerz session
  gatewayResponse Json?           // raw response stored for debugging
  refundId        String?         // gateway refund ID
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}
enum PaymentMethod {
  CARD
  BKASH
  CASH_ON_DELIVERY
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
   userId        String
  user          User        @relation(fields: [userId], references: [id])
 
   status      OrderStatus @default(PENDING)
  items       OrderItem[]
  couponId  String?
  coupon    Coupon?  @relation(fields: [couponId], references: [id])
  discount  Decimal  @default(0)
  payment   Payment?
  statusHistory OrderStatusHistory[]
  
  shipping      OrderAddress?
  
  subtotal      Decimal
  shippingCost  Decimal
  tax           Decimal
  total         Decimal

  currency      String      @default("TK")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
    @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])      // compound — my orders by status
}

model OrderAddress {
  id        String @id @default(cuid())

  orderId   String @unique
  order     Order?  @relation(fields: [orderId], references: [id])

  fullName  String
  phone     String
  street    String
  city      String
  state     String
  zipCode   String
  country   String
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id])
  quantity     Int
  productImage String
  variant     String?
  returnRequest ReturnRequest?
  priceAtTime  Decimal     // snapshot of price when ordered
  status       OrderItemStatus @default(PENDING)  // vendor controls this
  createdAt    DateTime    @default(now())
    @@index([orderId])
  @@index([storeId])
  @@index([productId])
  @@index([status])
}

enum OrderItemStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())

  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity  Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

// ── Notifications ─────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // ORDER_PLACED, ORDER_STATUS_CHANGED, NEW_ORDER_VENDOR, RETURN_REQUESTED, RETURN_RESOLVED
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
    @@index([userId])
  @@index([userId, isRead])          // compound — unread count query
  @@index([createdAt])
}
// ── Coupons ───────────────────────────────────────────────────────────────────
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  discountPercent Float   // e.g. 10 means 10%
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}
// ── Return/Refund ─────────────────────────────────────────────────────────────
enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderItemId String       @unique
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customerId  String
  customer    User         @relation(fields: [customerId], references: [id])
  reason      String
  status      ReturnStatus @default(PENDING)
  vendorNote  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId]) // one review per product per customer
    @@index([productId])
  @@index([customerId])
  @@index([rating])
}

