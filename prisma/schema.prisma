generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  fullName  String
  phone     String
  street    String
  city      String
  state     String?
  country   String   @default("Bangladesh")
  zipCode   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductQuestion {
  id         String    @id @default(cuid())
  productId  String
  customerId String
  question   String
  answer     String?
  answeredAt DateTime?
  answeredBy String?
  status     QStatus   @default(PENDING)
  moderatedAt DateTime?
  moderatedBy String?
  createdAt  DateTime  @default(now())
  customer   User      @relation("CustomerQuestions", fields: [customerId], references: [id])
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([customerId])
  @@index([status])
}

model StockAlert {
  id        String   @id @default(cuid())
  userId    String
  productId String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, notified])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                       String             @id @default(cuid())
  name                     String
  email                    String             @unique
  password                 String
  role                     Role               @default(CUSTOMER)
  isEmailVerified          Boolean            @default(false)
  emailVerifyToken         String?
  emailVerifyExpiry        DateTime?
  passwordResetToken       String?
  passwordResetExpiry      DateTime?
  emailNotificationEnabled Boolean            @default(true)
  phone                    String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  notifDeliveryAlerts      Boolean            @default(true)
  notifOrderUpdates        Boolean            @default(true)
  notifPromotions          Boolean            @default(true)
  notifReviewReminder      Boolean            @default(false)
  notifWeeklyDigest        Boolean            @default(false)
  notifWishlistSale        Boolean            @default(true)
  addresses                Address[]
  cart                     Cart?
  notifications            Notification[]
  orders                   Order[]
  questions                ProductQuestion[]  @relation("CustomerQuestions")
  pushSubscriptions        PushSubscription[]
  returnRequests           ReturnRequest[]
  reviews                  Review[]
  stockAlerts              StockAlert[]
  store                    Store?
  wishlist                 Wishlist?
  avatar   String?
  website  String?
  location String?
  isBanned Boolean  @default(false)

  @@index([email])
  @@index([role])
}

model Store {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  description  String?
  logo         String?
  ownerId      String      @unique
  isActive     Boolean     @default(true)
  totalSales   Int         @default(0)
  totalRevenue Decimal     @default(0)
  rating       Float       @default(0)
  isFeatured   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  badge        String?
  bio          String?
  coverImage   String?
  isApproved   Boolean     @default(false)
  offers       String?
  specialty    String?
  returnPolicy   String?
  shippingPolicy String?
  orderItems   OrderItem[]
  products     Product[]
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payouts Payout[]

  // Vendor settings
  taxId             String?
  currency          String   @default("USD")
  payoutCycle       String   @default("monthly")
  minPayout         Decimal  @default(100)
  autoAcceptOrders  Boolean  @default(true)
  autoUpdateStock   Boolean  @default(true)
  notifNewOrder        Boolean @default(true)
  notifOrderCancelled  Boolean @default(true)
  notifLowStock        Boolean @default(true)
  notifNewReview       Boolean @default(true)
  notifPayoutSent      Boolean @default(true)
  notifReturnRequest   Boolean @default(true)
  notifWeeklyReport    Boolean @default(false)
  notifMarketingTips   Boolean @default(false)

  @@index([ownerId])
  @@index([isActive])
  @@index([slug])
  @@index([totalSales])
  @@index([rating])
}

model Payout {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("PENDING")
  method    String   @default("Bank Transfer")
  reference String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payouts")
}

model Category {
  id         String    @id @default(cuid())
  name       String    @unique
  slug       String    @unique
  isFeatured Boolean?  @default(false)
  image      String?
  createdAt  DateTime  @default(now())
  products   Product[]
}

model Product {
  id             String                 @id @default(cuid())
  name           String
  slug           String                 @unique
  description    String?
  overview       Json?
  details        Json?
  highlights     Json?
  additionalInfo Json?
  price          Decimal
  originalPrice  Decimal?
  stock          Int                    @default(0)
  storeId        String
  categoryId     String
  isActive       Boolean                @default(true)
  featured       Boolean                @default(false)
  bestseller     Boolean                @default(false)
  rating         Float                  @default(0)
  reviewCount    Int                    @default(0)
  brandId        String?
  orderCount     Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  cartItems      CartItem[]
  orderItems     OrderItem[]
  brand          Brand?                 @relation(fields: [brandId], references: [id])
  category       Category               @relation(fields: [categoryId], references: [id])
  store          Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  questions      ProductQuestion[]
  specifications ProductSpecification[]
  tags           ProductTag[]
  variants       ProductVariant[]
  reviews        Review[]
  stockAlerts    StockAlert[]
  wishlistItems  WishlistItem[]

  @@index([storeId])
  @@index([categoryId])
  @@index([isActive])
  @@index([price])
  @@index([createdAt])
  @@index([storeId, isActive])
  @@index([categoryId, isActive])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logo        String? 
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  productId String
  publicId  String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isPrimary])
}

model ProductVariant {
  id        String     @id @default(cuid())
  name      String
  value     String
  price     Decimal?
  stock     Int        @default(0)
  productId String
  cartItems CartItem[]
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpecification {
  id        String   @id @default(uuid())
  key       String
  value     String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Payment {
  id              String         @id @default(cuid())
  orderId         String         @unique
  status          PaymentStatus  @default(PENDING)
  cardName        String?
  last4           String?
  provider        String?
  gateway         PaymentGateway
  amount          Decimal
  currency        String         @default("BDT")
  transactionId   String?
  sessionId       String?
  gatewayResponse Json?
  refundId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  order           Order          @relation(fields: [orderId], references: [id])
}

model Order {
  id            String               @id @default(cuid())
  userId        String?
  guestId       String?
  guestEmail    String?
  guestName     String?
  guestPhone    String?
  status        OrderStatus          @default(PENDING)
  couponId      String?
  discount      Decimal              @default(0)
  subtotal      Decimal
  shippingCost  Decimal
  tax           Decimal
  total         Decimal
  currency      String               @default("TK")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  coupon        Coupon?              @relation(fields: [couponId], references: [id])
  user          User?                @relation(fields: [userId], references: [id])
  shipping      OrderAddress?
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payment       Payment?

  @@index([userId])
  @@index([guestId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@index([guestEmail])
}

model OrderAddress {
  id       String @id @default(cuid())
  orderId  String @unique
  fullName String
  phone    String
  street   String
  city     String
  state    String?
  zipCode  String
  country  String
  order    Order  @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  productId     String
  storeId       String
  quantity      Int
  productImage  String
  variant       String?
  priceAtTime   Decimal
  status        OrderItemStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  store         Store           @relation(fields: [storeId], references: [id])
  returnRequest ReturnRequest?

  @@index([orderId])
  @@index([storeId])
  @@index([productId])
  @@index([status])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String?        @unique
  guestId   String?        @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  guestId   String?    @unique
  couponId  String?
  coupon    Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  discountType    DiscountType @default(PERCENTAGE)
  discountValue   Float
  discountPercent Float        @default(0)
  minOrderAmount  Float?
  maxDiscount     Float?
  usageLimit      Int?
  usedCount       Int          @default(0)
  startDate       DateTime?
  expiryDate      DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  orders          Order[]
  carts           Cart[]
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderItemId String       @unique
  customerId  String
  reason      String
  status      ReturnStatus @default(PENDING)
  vendorNote  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  customer    User         @relation(fields: [customerId], references: [id])
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
  @@index([customerId])
  @@index([rating])
}

enum Role {
  SUPER_ADMIN
  CUSTOMER
  VENDOR
  ADMIN
}

enum NotificationTargetType {
  USER
  USERS
  ROLE
  ALL_USERS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentGateway {
  SSLCOMMERZ
  STRIPE
  BKASH
  MANUAL
}

enum PaymentMethod {
  CARD
  BKASH
  CASH_ON_DELIVERY
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QStatus {
  PENDING
  APPROVED
  REJECTED
}
