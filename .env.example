# ── Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/Electromart

# ── JWT ────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_random_64_char_hex_string
JWT_REFRESH_SECRET=change_me_to_a_different_random_64_char_hex_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CSRF ───────────────────────────────────────────────────────────────
CSRF_SECRET=change_me_to_a_random_64_char_hex_string

# ── Cloudinary ─────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Stripe ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── SSLCommerz ─────────────────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_SESSION_URL=https://sandbox.sslcommerz.com/gwprocess/v3/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSLCOMMERZ_SUCCESS_URL_PRODUCT=http://localhost:5000/api/v1/payments/sslcommerz/success
SSLCOMMERZ_FAIL_URL_PRODUCT=http://localhost:5000/api/v1/payments/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL_PRODUCT=http://localhost:5000/api/v1/payments/sslcommerz/cancel
SSLCOMMERZ_IS_SANDBOX=true

# ── Redis (BullMQ) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Email (SMTP) ───────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
APP_EMAIL_FROM=noreply@Electromart.com

# ── Super Admin Seed ───────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@Electromart.com
SUPER_ADMIN_PASSWORD=Admin@1234
SUPER_ADMIN_ROLE=SUPER_ADMIN
AUTO_SEED_SUPER_ADMIN=true

# ── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_WHITELIST_IPS=
